{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/index.py" },
    { "src": "/health", "dest": "/index.py" },
    { "src": "/health/detail", "dest": "/index.py" },
    { "src": "/metrics", "dest": "/index.py" },
    { "src": "/chat", "dest": "/index.py" },
    { "src": "/chat/stream", "dest": "/index.py" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
