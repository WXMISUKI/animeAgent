# LLM 配置 - 豆包（必需）
# 通过火山引擎获取：https://console.volcengine.com/ark
ORCH_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ORCH_MODEL=your-doubao-endpoint-id
ORCH_API_KEY=your-ark-api-key

# 番剧数据源配置（可选）
# Jikan API (MyAnimeList) - 无需配置
# AniList API - 无需配置
# Bangumi API
# BANGUMI_API_URL=https://api.bangumi.tv/v0

# 百度搜索 API 配置（可选）
# 通过百度智能云千帆获取：https://qianfan.baidubce.com/
BAIDU_SEARCH_API_KEY=your-baidu-search-api-key

# 日志配置（可选）
LOG_LEVEL=INFO
LOG_FILE=logs/anime_agent.log

# 缓存配置（可选）
CACHE_TTL=3600

# 服务配置（可选）
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ====== CORS 配置 ======
# 多个域名用逗号分隔，本地开发可设为 *
CORS_ALLOW_ORIGINS=*

# ====== API 鉴权（生产环境建议开启） ======
# 开启后 /api/* 和 /chat* 路径需携带 API Key
API_AUTH_ENABLED=false
API_AUTH_KEY=your-strong-api-key
API_AUTH_HEADER=x-api-key

# ====== Checkpoint/会话（Vercel 无外部服务时建议）======
# 说明：在 Vercel Serverless 上，memory 仅”尽力可用”，实例重启后会丢失
ENABLE_CHECKPOINT=true
CHECKPOINT_BACKEND=memory
CHECKPOINT_THRESHOLD=1
CHECKPOINT_MAX_HISTORY=20
